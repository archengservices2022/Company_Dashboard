rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Allow all signed-in users full access for development
    // Note: In production, implement proper role-based access control

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
